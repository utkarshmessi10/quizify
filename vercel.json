{
  "version": 2,
  "builds": [
    {
      "src": "server/server/app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server/server/data/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/server/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "server/server/public/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}